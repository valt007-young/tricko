# TRIKO environment variables
# Copy this file to .env.local and fill in your Supabase project values.
# Get them from: Supabase Dashboard → Project Settings → API
#
# Local dev with the Supabase CLI:
#   supabase start   # prints the local URL + anon key
# then set the values below to http://127.0.0.1:54321 and the anon key.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets (NEVER add NEXT_PUBLIC_ prefix, never expose to the browser)
# Only needed for scripts/seed-demo.mjs (demo data loader).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cashfree Payments Gateway (https://merchant.cashfree.com → Dashboard → Settings → API Keys)
# Sandbox credentials from https://sandbox.cashfree.com
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret
# "sandbox" for testing (test cards / UPI), "production" for live money.
CASHFREE_ENV=sandbox
# Public copy for the browser SDK — must match CASHFREE_ENV.
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# Public site URL (used for share cards / canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode: planting completes instantly with a simulated payment (no Cashfree keys
# needed). Defaults to "true" when unset. Set to "false" once real Cashfree
# credentials are configured.
NEXT_PUBLIC_DEMO_MODE=true